# Copy this file to `.env.local` in the same directory (next to package.json),
# then replace every placeholder with real values. Never commit `.env.local`.
#
#   cp .env.local.example .env.local
#
# Restart `npm run dev` after changing NEXT_PUBLIC_* or Clerk keys.

# ── Clerk (dashboard.clerk.com → your app → API Keys → Development) ──────────
# Use the Development pair for local dev (pk_test_ / sk_test_).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# Platform super-admin (Clerk user IDs, comma-separated) — optional locally
PLATFORM_ADMIN_CLERK_IDS=

# Tenant impersonation for training/debug (min 32 random chars). Required to use
# POST /api/admin/impersonate from Platform admin.
IMPERSONATION_SECRET=

# ── Commercial trade account portal (accounts.<brand>.com.au) ───────────────
# Trade contacts sign in with a magic link, not Clerk. Signs the bh_portal
# session cookie (min 32 random chars) — required for the portal to work at all.
#   openssl rand -base64 32
PORTAL_SESSION_SECRET=
# orgs.slug that owns the trade accounts served from the accounts host. Without
# it the portal returns 404, the same gating pattern as JOB_INBOUND_EMAIL_ORG_SLUGS.
ACCOUNTS_PORTAL_ORG_SLUG=
# Local dev only: there is no accounts host on localhost, so this decides which
# brand /portal renders. Defaults to forensic_cleaning_qld.
ACCOUNTS_PORTAL_DEV_TRADING_NAME=forensic_cleaning_qld

# ── Supabase (supabase.com → Project → Settings → API) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...
SUPABASE_SERVICE_ROLE_KEY=eyJh...

# ── Anthropic (console.anthropic.com) ───────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── App URL ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Email (resend.com) ──────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NOTIFICATIONS=
# Used for team invite emails (Team → profile → App Access → Send email) and nudges
RESEND_FROM_TEAM=teams@yourdomain.com
RESEND_FROM_PLATFORM=platform@yourdomain.com
# Fallback sender for trade account magic links, used only while a brand's own
# domain is unverified in Resend. Normally the address comes from the brand's
# entry in src/lib/tradingNames.ts.
RESEND_FROM_ACCOUNTS=
NOTIFY_EMAIL=hello@yourdomain.com
# Receives the alert when a trade account accepts a quote in the portal.
ACCOUNTS_EMAIL=accounts@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# ── Twilio (optional for SMS features locally) ──────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Google Maps (Places API New — site address autocomplete) ────────────────
# 1. Google Cloud Console → enable "Places API (New)" + "Maps JavaScript API"
# 2. Create an API key, restrict by HTTP referrer:
#      http://localhost:3000/*
#      https://app.biohazards.net/*
#    and restrict to those two APIs only.
# 3. Billing must be enabled (the $200/mo free credit covers typical volume).
# If this key is unset, the site address input falls back to a plain textbox.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
